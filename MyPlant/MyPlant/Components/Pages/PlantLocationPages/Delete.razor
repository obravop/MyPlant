@page "/plantlocations/delete"
@using Microsoft.EntityFrameworkCore
@using MyPlant.Models
@inject IDbContextFactory<MyPlant.Data.MyPlantContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>PlantLocation</h2>
    <hr />
    @if (plantlocation is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@plantlocation.Name</dd>
        </dl>
        <EditForm method="post" Model="plantlocation" OnValidSubmit="DeletePlantLocation" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(plantlocation is null)">Delete</button> |
            <a href="/plantlocations">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private PlantLocation? plantlocation;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        plantlocation = await context.PlantLocation.FirstOrDefaultAsync(m => m.Id == Id);

        if (plantlocation is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeletePlantLocation()
    {
        using var context = DbFactory.CreateDbContext();
        context.PlantLocation.Remove(plantlocation!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/plantlocations");
    }
}
