@page "/plants/delete"
@using Microsoft.EntityFrameworkCore
@using MyPlant.Models
@inject IDbContextFactory<MyPlant.Data.MyPlantContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Plant</h2>
    <hr />
    @if (plant is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">CreationDate</dt>
            <dd class="col-sm-10">@plant.CreationDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">WateringDate</dt>
            <dd class="col-sm-10">@plant.WateringDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ImageBase64</dt>
            <dd class="col-sm-10">@plant.ImageBase64</dd>
        </dl>
        <EditForm method="post" Model="plant" OnValidSubmit="DeletePlant" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(plant is null)">Delete</button> |
            <a href="/plants">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Plant? plant;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        plant = await context.Plant.FirstOrDefaultAsync(m => m.Id == Id);

        if (plant is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeletePlant()
    {
        using var context = DbFactory.CreateDbContext();
        context.Plant.Remove(plant!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/plants");
    }
}
