@page "/planttypes/delete"
@using Microsoft.EntityFrameworkCore
@using MyPlant.Models
@inject IDbContextFactory<MyPlant.Data.MyPlantContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>PlantType</h2>
    <hr />
    @if (planttype is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@planttype.CommonName</dd>
        </dl>
        <EditForm method="post" Model="planttype" OnValidSubmit="DeletePlantType" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(planttype is null)">Delete</button> |
            <a href="/planttypes">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private PlantType? planttype;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        planttype = await context.PlantType.FirstOrDefaultAsync(m => m.Id == Id);

        if (planttype is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeletePlantType()
    {
        using var context = DbFactory.CreateDbContext();
        context.PlantType.Remove(planttype!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/planttypes");
    }
}
