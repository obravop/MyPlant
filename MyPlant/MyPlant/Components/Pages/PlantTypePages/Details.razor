@page "/planttypes/details"
@using Microsoft.EntityFrameworkCore
@using MyPlant.Models
@inject IDbContextFactory<MyPlant.Data.MyPlantContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>PlantType</h2>
    <hr />
    @if (planttype is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@planttype.CommonName</dd>
        </dl>
        <div>
            <a href="@($"/planttypes/edit?id={planttype.Id}")">Edit</a> |
            <a href="@($"/planttypes")">Back to List</a>
        </div>
    }
</div>

@code {
    private PlantType? planttype;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        planttype = await context.PlantType.FirstOrDefaultAsync(m => m.Id == Id);

        if (planttype is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
